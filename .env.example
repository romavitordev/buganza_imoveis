# ============================================================
# Marcelo Imóveis — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# ============================================================

# Postgres (recomendado: Neon — https://neon.tech, plano gratuito)
#
# EM PRODUÇÃO SÃO DUAS URLs, e usar a errada só dá problema quando o
# site tem movimento:
#
#   DATABASE_URL = a POOLED, com "-pooler" no host. É a que o site usa.
#                  Cada função da Vercel abre o próprio pool de conexões;
#                  sem o PgBouncer na frente, alguns acessos ao mesmo
#                  tempo estouram o limite do Neon e o site passa a
#                  responder erro. Com um usuário só testando, a URL
#                  direta funciona — por isso a armadilha.
#
#   DIRECT_URL   = a DIRETA, sem "-pooler". Usada só por
#                  `npm run db:push` e migrações, que precisam de uma
#                  sessão real.
#
# No Neon as duas ficam lado a lado na tela de conexão.
# Em desenvolvimento, aponte as duas para o mesmo Postgres local.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/imoveis?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/imoveis?sslmode=require"

# Segredo do JWT da sessão do admin (obrigatório — o app não sobe sem ele).
# Gere um valor forte, ex.: `openssl rand -base64 32`
AUTH_SECRET=""

# Supabase Storage (bucket público "imoveis") — usado para as fotos.
# Em desenvolvimento, se deixar vazio, o upload cai em public/uploads (NÃO funciona na Vercel).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Credenciais do admin criadas pelo seed (npm run db:seed)
# TROQUE antes de ir ao ar — veja CHECKLIST-DEPLOY.md.
ADMIN_EMAIL="marceloimoveissorocaba@gmail.com"
ADMIN_PASSWORD="admin123"

# Número do WhatsApp que recebe os contatos (só dígitos: 55 + DDD + número).
# SERVER-ONLY: não vai ao navegador. O site redireciona por /api/contato,
# então o número não aparece no "inspecionar" nem é colhido por bots.
# Número oficial da Marcelo Imóveis: +55 15 99829-6767
WHATSAPP_NUMBER="5515998036636"

# URL pública do site em produção (usada em sitemap, robots e Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.marceloimoveis.com.br"

# Aviso de lead novo por e-mail (Resend — https://resend.com, 3.000/mês grátis).
# Vazio = aviso desligado; o lead continua sendo salvo na caixa do painel.
# LEAD_NOTIFY_FROM é opcional: sem domínio verificado no Resend, o padrão
# "Marcelo Imóveis <onboarding@resend.dev>" já funciona.
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL="marceloimoveissorocaba@gmail.com"
# LEAD_NOTIFY_FROM="Marcelo Imóveis <avisos@marceloimoveis.com.br>"

# Rate limit durável (Upstash Redis — https://upstash.com, plano gratuito).
# Vazio = limite em memória (ok em dev; na Vercel ele zera a cada reinício).
# Em produção, crie um banco Redis no Upstash e cole a URL/token REST aqui.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
