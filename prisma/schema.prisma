// Schema do banco — Marcelo Imóveis
//
// Para desenvolvimento local SEM Postgres, dá para trocar para SQLite,
// mas atenção — o Prisma NÃO suporta enums em SQLite, então a troca exige:
//   1. Em `datasource db`, mude `provider = "postgresql"` para `provider = "sqlite"`
//   2. No .env, use: DATABASE_URL="file:./dev.db"
//   3. Remova as anotações exclusivas de Postgres: `@db.Text` (em Property.descricao)
//      e `@db.Decimal(12, 2)` (em Property.precoInterno)
//   4. Substitua os campos que usam enums (tipo, transacao, status) por `String`
//      e remova os blocos `enum` — os valores continuam os mesmos em runtime
//   5. Rode `npm run db:push` e `npm run db:seed` normalmente
// Recomendação: prefira um Postgres gratuito no Neon (https://neon.tech) —
// leva 2 minutos e evita essas alterações.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // DUAS URLs, e a diferença entre elas decide se o site aguenta o dia
  // do lançamento.
  //
  // `url` é a conexão POOLED (no Neon, o host termina em "-pooler").
  // Cada função serverless da Vercel abre o próprio pool do Prisma; sem
  // um PgBouncer na frente, um punhado de acessos simultâneos estoura o
  // limite de conexões do Neon e as requisições passam a falhar com
  // "too many connections". O problema não aparece em teste — com um
  // usuário só, a URL direta funciona perfeitamente.
  //
  // `directUrl` é a conexão DIRETA, usada só por `prisma db push` e
  // pelas migrações: elas precisam de uma sessão real, que o PgBouncer
  // em modo transaction não oferece.
  //
  // Em desenvolvimento as duas apontam para o mesmo Postgres local e
  // nada muda.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoImovel {
  RESIDENCIAL
  COMERCIAL
  TERRENO
}

// Subtipo refina o tipo: "Residencial" não deixa ninguém buscar
// "apartamento". Opcional — anúncios antigos seguem válidos sem ele.
enum SubtipoImovel {
  CASA
  SOBRADO
  APARTAMENTO
  KITNET
  CHACARA
  SALA_COMERCIAL
  LOJA
  GALPAO
  TERRENO_URBANO
  TERRENO_CONDOMINIO
}

enum Transacao {
  VENDA
  LOCACAO
  VENDA_LOCACAO
}

enum StatusImovel {
  ATIVO
  PAUSADO
  VENDIDO
  ALUGADO
}

enum TipoEvento {
  VISUALIZACAO
  CLIQUE_WHATSAPP
}

enum StatusLead {
  NOVO
  CONTATADO
  DESCARTADO
}

model AdminUser {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  passwordHash String
  /// 2FA (TOTP): segredo base32. Preenchido no inicio da configuracao;
  /// so vale depois que totpAtivadoEm confirma o primeiro codigo.
  totpSecret    String?
  totpAtivadoEm DateTime?
  criadoEm     DateTime @default(now())
}

model Property {
  id           String       @id @default(cuid())
  codigo       String       @unique
  slug         String       @unique
  titulo       String
  descricao    String       @db.Text
  tipo         TipoImovel
  transacao    Transacao
  status       StatusImovel @default(ATIVO)
  destaque     Boolean      @default(false)

  cidade       String
  bairro       String
  // Endereço opcional usado SÓ para posicionar o pino do mapa no site.
  // Vazio = mapa mostra a região do bairro (localização aproximada).
  enderecoMapa String?

  subtipo      SubtipoImovel?

  quartos      Int?
  // Suítes contam DENTRO de quartos (3 quartos, sendo 1 suíte)
  suites       Int?
  banheiros    Int?
  vagas        Int?
  // areaM2 = área útil/construída; terreno tem campo próprio
  areaM2        Int?
  areaTerrenoM2 Int?

  // Custos recorrentes — exibidos na ficha do imóvel quando preenchidos
  condominioMensal Decimal? @db.Decimal(12, 2)
  iptuAnual        Decimal? @db.Decimal(12, 2)

  // Comodidades estruturadas (valores do catálogo em lib/comodidades.ts) —
  // viram badges com ícone no site e filtros no futuro
  comodidades  String[]     @default([])

  // Preços PÚBLICOS — exibidos no site (cards e detalhe).
  // Ausente = "Sob consulta".
  precoVenda   Decimal?     @db.Decimal(12, 2)
  precoLocacao Decimal?     @db.Decimal(12, 2)

  // Preço para organização interna do casal — NUNCA aparece no site público.
  // A allowlist de lib/dto.ts garante que este campo jamais é serializado
  // em respostas de rotas públicas.
  precoInterno Decimal?     @db.Decimal(12, 2)

  // Vídeo do imóvel — aparece SÓ na página de detalhe, abaixo da galeria.
  // Nunca é usado como capa do card nem nos destaques.
  videoUrl        String?
  videoStorageKey String?

  fotos        PropertyPhoto[]
  eventos      PropertyEvent[]
  leads        Lead[]
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@index([status, destaque])
  @@index([tipo, transacao, cidade])
}

// Eventos de analytics do site público: visualizações da página do imóvel
// e cliques nos botões de WhatsApp. Alimentam as métricas do dashboard.
//
// LGPD: nenhum dado pessoal cru é armazenado. `dedupeHash` é um SHA-256 de
// IP+navegador usado apenas para não contar o mesmo dispositivo duas vezes
// no mesmo dia — o IP em si nunca é gravado.
model PropertyEvent {
  id          String     @id @default(cuid())
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  tipo        TipoEvento
  // Contexto anônimo do acesso
  dispositivo String? // MOBILE | DESKTOP | TABLET
  origem      String? // utm_source ou domínio do referrer (ex.: instagram.com)
  dedupeHash  String? // pseudônimo do dispositivo (nunca o IP cru)
  criadoEm    DateTime   @default(now())

  @@index([propertyId, tipo, criadoEm])
  @@index([dedupeHash, tipo, criadoEm])
}

// Lead do site: visitante que deixou contato no formulário "Tenho
// interesse" em vez de (ou além de) abrir o WhatsApp.
//
// LGPD: dados coletados com consentimento explícito no formulário,
// usados apenas para retornar o contato sobre o imóvel.
model Lead {
  id         String     @id @default(cuid())
  // SetNull: excluir o imóvel não apaga o lead (o contato ainda vale)
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId String?
  nome       String
  whatsapp   String
  mensagem   String?    @db.Text
  origem     String?
  status     StatusLead @default(NOVO)
  criadoEm   DateTime   @default(now())

  @@index([status, criadoEm])
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  url        String
  storageKey String
  ordem      Int      @default(0)
  capa       Boolean  @default(false)

  @@index([propertyId, ordem])
}

// Perguntas do chat que caíram no fallback ("não sei responder") — a
// matéria-prima para evoluir a base do Assistente Marcelo com o tempo.
enum StatusPergunta {
  NOVA
  RESPONDIDA
  IGNORADA
}

model ChatPergunta {
  id       String         @id @default(cuid())
  texto    String         @db.VarChar(200)
  status   StatusPergunta @default(NOVA)
  criadoEm DateTime       @default(now())

  @@index([status, criadoEm])
}

/// Respostas escritas pelos corretores no painel (/admin/suporte). O bot
/// usa estas JUNTO com os topicos fixos de lib/chatbot.ts — e assim a base
/// cresce sem precisar de deploy.
model ChatConhecimento {
  id       String   @id @default(cuid())
  /// Titulo curto do assunto — vira o rotulo do chip no chat.
  titulo   String   @db.VarChar(80)
  /// Palavras que ativam a resposta quando o visitante digita.
  palavras String[] @default([])
  resposta String   @db.Text
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
}
